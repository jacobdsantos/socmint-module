# Copy to .env and fill in, or export these in your shell.
#
# Only Reddit needs credentials. Everything else works without a key.
# These are never read from a committed file at runtime -- the module reads the
# process environment, so .env is for your own tooling, not a loader.

# Free: https://www.reddit.com/prefs/apps -> "create another app" -> script
# The client id is the short string under "personal use script";
# the secret is the one labelled "secret".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
